<ModifierDefs>
    <List>

        <!-- ==================== 卷轴强化 ==================== -->

        <Modifier Name="ACS1_SupremeCultivationModifier"
                  Type="Normal">

            <DisplayName>天道逆命</DisplayName>

            <Desc>
                百万金丹专用逆天强化。
            </Desc>

            <MaxStack>1</MaxStack>

            <Duration>-1</Duration>

            <Display>0</Display>

            <Sync>1</Sync>

            <!-- 五维各 +10 -->
            <BaseFive>10,10,10,10,10</BaseFive>

            <Properties>

                <!-- ==================== 炼宝 ==================== -->

                <!-- 炼宝速度 -->
                <li Name="FabaoMake_SpeedAddV" AddV="999"/>

                <!-- 炼宝成功率 -->
                <li Name="FabaoMake_SuccessRateAddV" AddV="10"/>

                <!-- 炼宝品阶 -->
                <li Name="FabaoMake_LingInheritRateAddV" AddV="100"/>

                <!-- 炼宝品质 -->
                <li Name="FabaoMake_QualityAddV" AddV="10"/>

                <!-- 神器/T12 概率 -->
                <li Name="FabaoMake_TwelveRateChance" AddV="10"/>


                <!-- ==================== 修炼/领悟 ==================== -->

                <!-- 心境 -->
                <li Name="MindStateBaseValue" AddV="100"/>

                <!-- 修炼速度 -->
                <li Name="DeepPracticeSpeedSpecialCoefficient" AddV="999999"/>

                <!-- 领悟/参悟相关倍率 -->
                <li Name="InspirationCoefficient" AddP="10"/>


                <!-- ==================== 移动/工作 ==================== -->

                <!-- 移动速度 +1000% -->
                <li Name="MoveSpeed" AddP="10.0"/>

                <!-- 总体工作效率 +1600% -->
                <li Name="GlobalEfficiency" AddP="16.0"/>

                <!-- 手工工作速度 +1600% -->
                <li Name="HandworkSpeed" AddP="16.0"/>


                <!-- ==================== 温度耐受 ==================== -->

                <!-- 最高耐受温度 +100 -->
                <li Name="ToleranceTMax" AddV="100"/>

                <!-- 最低耐受温度 -100 -->
                <li Name="ToleranceTMin" AddV="-100"/>


                <!-- ==================== 精力/精元 ==================== -->

                <!-- 精力消耗进一步降低 -->
                <li Name="FatigueConsumeConstant" AddV="-0.9999"/>

                <!-- 精元转化效率 -->
                <li Name="NutritionToJingYuanK" AddV="0.99"/>

            </Properties>

        </Modifier>


        <!-- ==================== 筑灵丹：永久增加灵力上限 ==================== -->

        <Modifier Name="ACS1_LingMaxPermanentModifier"
                  Type="Normal">

            <DisplayName>筑灵</DisplayName>

            <Desc>
                服用筑灵丹后，永久增加1000000点灵力上限。
            </Desc>

            <MaxStack>0</MaxStack>

            <Duration>-1</Duration>

            <Display>0</Display>

            <Sync>1</Sync>

            <Properties>

                <!-- 只有筑灵丹拥有这项 -->
                <li Name="NpcLingMaxValue" AddV="1000000"/>

            </Properties>

        </Modifier>

    </List>
</ModifierDefs>